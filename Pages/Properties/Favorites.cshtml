@page
@model RZ_nepremicnine.Pages.Properties.FavoritesModel
@{
    ViewData["Title"] = "Moji favoriti";
}

<h2 class="mb-4">❤️ Moje priljubljene nepremičnine</h2>

@if (!Model.Favorites.Any())
{
    <div class="alert alert-info">
        Nimate shranjenih nepremičnin.
    </div>
}
else
{
    <div class="row">
        @foreach (var n in Model.Favorites)
        {
            <div class="col-md-4">
                <div class="card mb-4 shadow-sm">
                    @if (n.Images.Any())
                    {
                        <img src="@n.Images.First().ImageUrl"
                             class="card-img-top"
                             alt="Nepremičnina" />
                    }

                    <div class="card-body">
                        <h5 class="card-title">@n.Naslov</h5>
                        <p class="card-text">
                            <strong>@n.Cena €</strong><br />
                            @n.Mesto, @n.Regija
                        </p>

                        <a asp-page="/Properties/Details"
                           asp-route-id="@n.Id"
                           class="btn btn-primary btn-sm">
                            Podrobnosti
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
